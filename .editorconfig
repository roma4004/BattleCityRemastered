# Shared source formatting, so CLion, Rider and VS don't rewrite files after each other.
root = true

[*]
# UTF-8 has no byte order, so a BOM is only a marker - and it breaks first-line diffs.
charset = utf-8
# LF as in .gitattributes (* text=auto eol=lf)
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,cpp,c,hpp}]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{vcxproj,filters,sln,props}]
# MSBuild and VS rewrite these themselves, always with CRLF.
end_of_line = crlf

# VS restores the BOM on every save of a project file, NuGet on every restore. The .filters
# (generated by scripts/gen-vcxproj-filters.ps1 via UTF8Encoding($false)) stay BOM-less.
[*.{sln,vcxproj}]
charset = utf-8-bom

[packages.config]
charset = utf-8-bom

# As in .gitattributes: cmd.exe is only reliable with CRLF.
[*.{bat,cmd}]
end_of_line = crlf
