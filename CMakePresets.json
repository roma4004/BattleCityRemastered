{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "Debug-MinGW",
      "displayName": "Debug-MinGW",
      "description": "Compilers come from the IDE toolchain / PATH - they are machine specific.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release-MinGW",
      "displayName": "Release-MinGW",
      "inherits": "Debug-MinGW",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug-MinGW",
      "configurePreset": "Debug-MinGW"
    },
    {
      "name": "Release-MinGW",
      "configurePreset": "Release-MinGW"
    }
  ],
  "testPresets": [
    {
      "name": "Debug-MinGW",
      "configurePreset": "Debug-MinGW",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
