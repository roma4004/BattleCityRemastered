<?xml version="1.0" encoding="utf-8"?>
<!-- In every project, not a PreBuildEvent of a few: the SDL3Wrappers leaves build first. -->
<Project>
  <Target Name="FetchSubmodules" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RepoRoot)scripts\fetch-submodules.ps1&quot; -Root &quot;$(RepoRoot).&quot;" />
  </Target>
</Project>
